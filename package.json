{
  "name": "www-of-anime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "validate:data": "node scripts/validate-data.mjs && node scripts/validate-forms.mjs",
    "test": "npm run test:auth && npm run test:game",
    "test:auth": "node --test tests/*.test.mjs",
    "test:game": "vitest run"
  },
  "dependencies": {
    "framer-motion": "^12.15.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
