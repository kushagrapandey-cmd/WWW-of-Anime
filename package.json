{
  "name": "www-of-anime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "validate:data": "node scripts/validate-catalog.mjs && node scripts/validate-data.mjs && node scripts/validate-forms.mjs && node scripts/validate-quizzes.mjs",
    "test": "npm run test:auth && npm run test:game && npm run test:server",
    "test:auth": "node --test tests/*.test.mjs",
    "test:game": "vitest run",
    "test:e2e": "playwright test",
    "dev:api": "node --env-file=.env.local server/dev.js",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "test:server": "node --test tests/server/*.test.mjs",
    "test:e2e:online": "playwright test -c playwright.online.config.js"
  },
  "dependencies": {
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@vercel/functions": "^3.9.10",
    "framer-motion": "^12.15.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
